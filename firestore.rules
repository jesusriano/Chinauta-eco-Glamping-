rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /domes/{domeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['reservation_code', 'customer_name', 'dome_id', 'check_in', 'check_out', 'total_amount']);
      allow update, delete: if isSignedIn();
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
